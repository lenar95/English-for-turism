{
  "name": "english-for-tourism",
  "private": true,
  "version": "1.0.0",
  "description": "Подготовка к поездке за границу: английский для русскоговорящих туристов",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run prerender",
    "prerender": "esbuild scripts/prerender.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/prerender.cjs --log-level=warning && node node_modules/.cache/prerender.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/.server/server.cjs --log-level=warning",
    "server": "node dist/.server/server.cjs",
    "lint": "oxlint",
    "knip": "knip",
    "test:offline": "node scripts/offline-smoke.cjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-speech-recognition": "^8.3.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "oxlint": "^1.86.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "web-push": "^3.6.7",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
